<?xml version="1.0" encoding="UTF-8"?>
<!--
  MilkyTracker.vst for the musica.studio installer (github.com/musicastudio/Installer). installer/build.sh
  builds it with this folder as the engine's product/; the Installer's own product/installer.xml says
  what each element does. "from" is a path in this repo's bin/ folder.
-->
<installer>
  <product name="MilkyTracker.vst" version="1.0.0" publisher="musica.studio" id="studio.musica.milkytrackervst"
           map="product/map.png" icon="product/icon.png"/>

  <updates url="https://musica.studio/updates/milkytracker/latest.json">
    <asset os="windows">MilkyTracker.vst-Windows-Installer.exe</asset>
    <asset os="darwin">MilkyTracker.vst-MacOS-Update</asset>
    <asset os="linux">MilkyTracker.vst-Linux-Installer</asset>
  </updates>

  <step type="box" button="install."/>
  <step type="licence" title="licence." button="next." file="product/LICENSE">
    MilkyTracker.vst is free software under the GNU General Public License v3, and MilkyPlay under the BSD licence. Use it for anything, share it and change it; if you share a changed version, share its source too.
  </step>
  <step type="components" title="formats." button="next.">
    Pick the formats your hosts load.
  </step>
  <step type="folders" title="folders." button="next.">
    These are the folders hosts scan by default.
  </step>
  <step type="options" title="options." button="install."/>
  <step type="progress" title="installing."/>
  <step type="finish" title="installed." button="close." box="true">
    Rescan plug-ins in your host to find MilkyTracker.vst.
  </step>

  <uninstall>
    <step type="box" button="uninstall."/>
    <step type="progress" title="removing."/>
    <step type="finish" title="removed." button="close.">
      MilkyTracker.vst is gone. Your modules and its settings are still there.
    </step>
  </uninstall>

  <component id="vst3" name="VST3" icon="icons/vst3.png" default="true"
             about="Steinberg's current format. Most hosts on Windows and macOS load it.">
    <target os="windows" from="VST3/MilkyTrackerVST.vst3" to="${CommonProgramFiles}\VST3"/>
    <target os="darwin" from="VST3/MilkyTrackerVST.vst3" to="~/Library/Audio/Plug-Ins/VST3"/>
    <target os="linux" from="VST3/MilkyTrackerVST.vst3" to="~/.vst3"/>
  </component>

  <component id="clap" name="CLAP" icon="icons/clap.png" default="true"
             about="The open format from Bitwig and u-he. Bitwig Studio, Reaper and others load it.">
    <target os="windows" from="CLAP/MilkyTrackerVST.clap" to="${CommonProgramFiles}\CLAP"/>
    <target os="darwin" from="CLAP/MilkyTrackerVST.clap" to="~/Library/Audio/Plug-Ins/CLAP"/>
    <target os="linux" from="CLAP/MilkyTrackerVST.clap" to="~/.clap"/>
  </component>

  <component id="au" name="AU" icon="icons/au.png" default="true"
             about="Apple's Audio Unit. Logic Pro and GarageBand load only this one.">
    <target os="darwin" from="AU/MilkyTrackerVST.component" to="~/Library/Audio/Plug-Ins/Components"/>
  </component>

  <component id="vst2" name="VST2" icon="icons/vst2.png" default="true"
             about="The older VST format, for hosts that never moved to VST3.">
    <target os="windows" from="VST2/MilkyTrackerVST.dll" to="${ProgramFiles}\VSTPlugins"/>
    <target os="darwin" from="VST2/MilkyTrackerVST.vst" to="~/Library/Audio/Plug-Ins/VST"/>
    <target os="linux" from="VST2/MilkyTrackerVST.so" to="~/.vst"/>
  </component>

  <component id="vst2-32" name="VST2 32-bit" icon="icons/vst2-32.png" default="true"
             about="A 32-bit VST2 with a DXi inside, for 32-bit hosts and Cakewalk's older DXi support.">
    <target os="windows" from="VST2 32-bit and DXi/MilkyTrackerVST.dll" to="${ProgramFiles(x86)}\VSTPlugins" register="true"/>
  </component>

  <component id="standalone" name="standalone" icon="icons/standalone.png" default="true"
             about="MilkyTracker.vst as its own app, with its own audio and MIDI settings. No host needed.">
    <target os="windows" from="Standalone/MilkyTrackerVST.exe" to="${ProgramFiles}\musica.studio\MilkyTracker.vst" shortcut="MilkyTracker.vst"/>
    <target os="darwin" from="Standalone/MilkyTrackerVST.app" to="/Applications"/>
    <target os="linux" from="Standalone/MilkyTrackerVST" to="~/.local/bin" shortcut="MilkyTracker.vst"/>
  </component>

  <option id="updater" name="updater" icon="icons/updater.png" default="true" note="recommended">
    Checks musica.studio at each login and quietly installs new releases.
  </option>
</installer>
